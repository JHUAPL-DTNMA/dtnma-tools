{
  "openapi": "3.0.0",
  "info": {
    "title": "REFDM REST API",
    "version": "2.0",
    "description": "Interface spec for the /nm/api/ subtree served by the REFDM.",
    "license": {
      "name": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "/nm/api",
      "description": "mount path for gateway"
    }
  ],
  "paths": {
    "/version": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Version": {
        "type": "object",
        "required": [
          "civetweb_version",
          "ari_version",
          "amp_version"
        ],
        "properties": {
          "civetweb_version": {
            "type": "string"
          },
          "ari_version": {
            "type": "string"
          },
          "amp_version": {
            "type": "string"
          }
        }
      }
    }
  }
}
